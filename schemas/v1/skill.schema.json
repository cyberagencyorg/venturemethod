{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "$id": "https://github.com/cyberagencyorg/venturemethod/schemas/v1/skill.schema.json",
  "additionalProperties": false,
  "required": [
    "name",
    "path",
    "origin",
    "status",
    "trust",
    "release"
  ],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "path": {
      "type": "string",
      "minLength": 1
    },
    "origin": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "trust": {
      "type": "string"
    },
    "release": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    }
  }
}

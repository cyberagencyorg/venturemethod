{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cyberagencyorg/venturemethod/schemas/v1/discovery.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "matches",
    "note"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "matches": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "score",
          "status",
          "matched_skill_ids",
          "matched_method_ids"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "score": {
            "type": "integer",
            "minimum": 1
          },
          "status": {
            "type": "string"
          },
          "matched_skill_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "matched_method_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "note": {
      "type": "string",
      "minLength": 1
    }
  }
}

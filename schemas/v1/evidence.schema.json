{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "$id": "https://github.com/cyberagencyorg/venturemethod/schemas/v1/evidence.schema.json",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "source_id",
    "source_sha256",
    "collected_at",
    "status",
    "kind",
    "sensitivity",
    "statement",
    "support_refs"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "source_id": {
      "type": "string",
      "minLength": 1
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "collected_at": {
      "type": "string",
      "format": "date-time"
    },
    "valid_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "enum": [
        "supported",
        "disputed",
        "unknown",
        "rejected"
      ]
    },
    "kind": {
      "enum": [
        "observation",
        "quotation",
        "publisher_assertion",
        "inference",
        "estimate"
      ]
    },
    "sensitivity": {
      "enum": [
        "public",
        "internal",
        "confidential",
        "restricted"
      ]
    },
    "statement": {
      "type": "string",
      "minLength": 1
    },
    "support_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "conflict_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}

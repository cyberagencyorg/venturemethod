{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "$id": "https://github.com/cyberagencyorg/venturemethod/schemas/v1/work-unit.schema.json",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "host_project",
    "objective",
    "phase",
    "existing_artifacts",
    "selected_capabilities",
    "allowed_tools",
    "authorized_effects",
    "review",
    "stop_when",
    "outputs"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "host_project": {
      "type": "string",
      "minLength": 1
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "phase": {
      "enum": [
        "starting",
        "in_flight",
        "review",
        "continuous"
      ]
    },
    "existing_artifacts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "selected_capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{0,63}$"
      }
    },
    "allowed_tools": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "authorized_effects": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "read",
          "draft",
          "external_write",
          "execute"
        ]
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner",
        "status",
        "required_before_effects"
      ],
      "properties": {
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "pending",
            "accepted",
            "rejected"
          ]
        },
        "required_before_effects": {
          "type": "boolean"
        }
      }
    },
    "stop_when": {
      "type": "string",
      "minLength": 1
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "seconds": {
          "type": "integer",
          "minimum": 0
        },
        "usd": {
          "type": "number",
          "minimum": 0
        }
      }
    }
  }
}

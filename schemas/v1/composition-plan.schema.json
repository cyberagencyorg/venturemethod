{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cyberagencyorg/venturemethod/schemas/v1/composition-plan.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project",
    "context_sha256",
    "status",
    "units",
    "excluded",
    "effects",
    "host_authority",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "context_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "status": {
      "enum": [
        "no_intervention",
        "advisory_composition"
      ]
    },
    "units": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": [
          "unit",
          "capability_id",
          "skill_id",
          "depends_on",
          "evidence_refs",
          "evidence_verification",
          "preconditions_covered"
        ],
        "additionalProperties": false,
        "properties": {
          "unit": {
            "$ref": "#/$defs/advisory_work_unit"
          },
          "capability_id": {
            "type": "string"
          },
          "skill_id": {
            "type": "string"
          },
          "depends_on": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence_verification": {
            "enum": [
              "excerpt_matched",
              "reference_only"
            ]
          },
          "preconditions_covered": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,63}$"
            }
          }
        }
      }
    },
    "excluded": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "capability_id",
          "reason"
        ],
        "properties": {
          "capability_id": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "effects": {
      "const": []
    },
    "host_authority": {
      "const": "retained"
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "advisory_work_unit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "id",
        "host_project",
        "objective",
        "phase",
        "existing_artifacts",
        "selected_capabilities",
        "allowed_tools",
        "authorized_effects",
        "review",
        "stop_when",
        "outputs"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}$"
        },
        "host_project": {
          "type": "string",
          "minLength": 1
        },
        "objective": {
          "type": "string",
          "minLength": 1
        },
        "phase": {
          "enum": [
            "starting",
            "in_flight",
            "review",
            "continuous",
            "unknown"
          ]
        },
        "existing_artifacts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "selected_capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          }
        },
        "allowed_tools": {
          "const": []
        },
        "authorized_effects": {
          "const": []
        },
        "review": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "owner",
            "status",
            "required_before_effects"
          ],
          "properties": {
            "owner": {
              "type": "string",
              "minLength": 1
            },
            "status": {
              "const": "pending"
            },
            "required_before_effects": {
              "const": true
            }
          }
        },
        "stop_when": {
          "type": "string",
          "minLength": 1
        },
        "outputs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "budget": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "seconds": {
              "type": "integer",
              "minimum": 0
            },
            "usd": {
              "type": "number",
              "minimum": 0
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "no_intervention"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "units": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "advisory_composition"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "units": {
            "minItems": 1
          }
        }
      }
    }
  ]
}

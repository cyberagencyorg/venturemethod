{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "$id": "https://github.com/cyberagencyorg/venturemethod/schemas/v1/host-state.schema.json",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task",
    "project",
    "authorization",
    "resources",
    "gaps"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "task": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "project": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "authorization": {
      "const": "host_read_only"
    },
    "covered_capabilities": {
      "type": "array",
      "maxItems": 40,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "resources": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "sha256"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9:._/-]{0,159}$"
          },
          "path": {
            "type": "string",
            "maxLength": 240
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "text": {
            "type": "string",
            "maxLength": 32768
          }
        }
      }
    },
    "gaps": {
      "type": "array",
      "maxItems": 24,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "capability_id",
          "status",
          "priority",
          "reason",
          "evidence_refs"
        ],
        "properties": {
          "capability_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "status": {
            "enum": [
              "unmet",
              "covered",
              "uncertain"
            ]
          },
          "priority": {
            "enum": [
              "critical",
              "high",
              "medium",
              "low"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 800
          },
          "evidence_refs": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9:._/-]{0,159}$"
            }
          }
        }
      }
    }
  }
}
